{
  "schemaVersion": 4,
  "project": {
    "name": "DocuMind",
    "stack": "python \u00b7 langchain \u00b7 ollama \u00b7 chroma",
    "definition": "A fully local, private document Q&A assistant. Point it at your PDFs; ask questions in natural language; answers are grounded in your own documents with citations. Nothing leaves your machine \u2014 embeddings and generation both run on local Ollama models, vectors live in a local Chroma store."
  },
  "boxes": [
    {
      "id": "ingest",
      "code": "L00B00",
      "layer": 0,
      "name": "Ingestion pipeline",
      "parent": null,
      "parallel": false,
      "loop": false,
      "connectors": [],
      "children": [
        "load",
        "split",
        "embed",
        "upsert"
      ],
      "maps": [
        "pipeline.py::ingest"
      ]
    },
    {
      "id": "query",
      "code": "L00B01",
      "layer": 0,
      "name": "Query & answer",
      "parent": null,
      "parallel": false,
      "loop": false,
      "connectors": [
        "ingest"
      ],
      "children": [
        "rewrite",
        "retrieve",
        "rerank",
        "generate"
      ],
      "maps": [
        "pipeline.py::answer"
      ]
    },
    {
      "id": "evalops",
      "code": "L00B02",
      "layer": 0,
      "name": "Eval & ops",
      "parent": null,
      "parallel": false,
      "loop": false,
      "connectors": [
        "query"
      ],
      "children": [
        "boxtests",
        "kpis",
        "costguard"
      ],
      "maps": [
        "eval.py::evaluate"
      ]
    },
    {
      "id": "load",
      "code": "L01B00",
      "layer": 1,
      "name": "Load PDFs",
      "parent": "ingest",
      "connectors": [],
      "children": [],
      "maps": [
        "loader.py::load_documents"
      ],
      "test": {
        "id": "load",
        "kind": "execution",
        "deterministic": true,
        "description": "Loads the bundled rulebooks",
        "expect": ">= 2 source documents"
      }
    },
    {
      "id": "split",
      "code": "L01B01",
      "layer": 1,
      "name": "Split into chunks",
      "parent": "ingest",
      "connectors": [
        "load"
      ],
      "children": [],
      "maps": [
        "loader.py::split_documents"
      ]
    },
    {
      "id": "embed",
      "code": "L01B02",
      "layer": 1,
      "name": "Embed (GPU)",
      "parent": "ingest",
      "connectors": [
        "split"
      ],
      "children": [],
      "maps": [
        "embeddings.py::embed_chunks"
      ],
      "model": "qwen3-embedding:4b"
    },
    {
      "id": "upsert",
      "code": "L01B03",
      "layer": 1,
      "name": "Upsert to Chroma",
      "parent": "ingest",
      "connectors": [
        "embed"
      ],
      "children": [],
      "maps": [
        "vectordb.py::add_to_chroma"
      ]
    },
    {
      "id": "rewrite",
      "code": "L01B04",
      "layer": 1,
      "name": "Query rewrite",
      "parent": "query",
      "connectors": [],
      "children": [],
      "maps": [
        "retriever.py::rewrite_query"
      ],
      "instruction": "Keyword extraction for retrieval. Was an LLM call (qwen3:4b) until PDM showed it burned ~1.6k tokens/run \u2014 more than the answer. Now a zero-token stop-word filter."
    },
    {
      "id": "retrieve",
      "code": "L01B05",
      "layer": 1,
      "name": "Retrieve top-k",
      "parent": "query",
      "connectors": [
        "rewrite"
      ],
      "children": [
        "embed_query",
        "vector_search"
      ],
      "maps": [],
      "kpis": [
        {
          "id": "retrieval_hit",
          "name": "Retrieval hit",
          "unit": "0/1"
        }
      ]
    },
    {
      "id": "embed_query",
      "code": "L02B02",
      "layer": 2,
      "name": "Embed query (GPU)",
      "parent": "retrieve",
      "connectors": [],
      "children": [],
      "maps": [
        "retriever.py::embed_query"
      ],
      "model": "qwen3-embedding:4b"
    },
    {
      "id": "vector_search",
      "code": "L02B03",
      "layer": 2,
      "name": "Vector search",
      "parent": "retrieve",
      "connectors": [
        "embed_query"
      ],
      "children": [],
      "maps": [
        "retriever.py::vector_search"
      ],
      "test": {
        "id": "vector_search",
        "kind": "execution",
        "deterministic": true,
        "description": "Top-k nearest neighbours for the fixed query",
        "expect": "k chunks, monopoly rulebook ranked first"
      }
    },
    {
      "id": "rerank",
      "code": "L01B06",
      "layer": 1,
      "name": "Rerank chunks",
      "parent": "query",
      "connectors": [
        "retrieve"
      ],
      "children": [],
      "maps": [
        "retriever.py::rerank"
      ],
      "test": {
        "id": "rerank",
        "kind": "execution",
        "deterministic": true,
        "description": "Reorders chunks by query-keyword overlap",
        "expect": "most on-topic chunk ranked first"
      }
    },
    {
      "id": "generate",
      "code": "L01B07",
      "layer": 1,
      "name": "Generate answer",
      "parent": "query",
      "connectors": [
        "rerank"
      ],
      "children": [
        "build_prompt",
        "llm_answer"
      ],
      "maps": []
    },
    {
      "id": "build_prompt",
      "code": "L02B00",
      "layer": 2,
      "name": "Build prompt",
      "parent": "generate",
      "connectors": [],
      "children": [],
      "maps": [
        "generate.py::build_prompt"
      ],
      "test": {
        "id": "build_prompt",
        "kind": "execution",
        "deterministic": true,
        "description": "Prompt embeds the retrieved context + question",
        "expect": "prompt contains all k chunks and the question"
      }
    },
    {
      "id": "llm_answer",
      "code": "L02B01",
      "layer": 2,
      "name": "LLM answer (GPU)",
      "parent": "generate",
      "connectors": [
        "build_prompt"
      ],
      "children": [],
      "maps": [
        "generate.py::llm_answer"
      ],
      "model": "qwen3:8b",
      "kpis": [
        {
          "id": "answer_quality",
          "name": "Answer quality",
          "unit": "score"
        }
      ]
    },
    {
      "id": "boxtests",
      "code": "L01B08",
      "layer": 1,
      "name": "Box tests",
      "parent": "evalops",
      "connectors": [],
      "children": [],
      "maps": [
        "eval.py::run_box_tests"
      ],
      "test": {
        "id": "boxtests",
        "kind": "execution",
        "deterministic": true,
        "description": "Runs every box's deterministic check",
        "expect": "all box tests pass"
      },
      "parallel": true
    },
    {
      "id": "kpis",
      "code": "L01B09",
      "layer": 1,
      "name": "Record KPIs",
      "parent": "evalops",
      "connectors": [
        "boxtests"
      ],
      "children": [],
      "maps": [
        "eval.py::record_kpis"
      ]
    },
    {
      "id": "costguard",
      "code": "L01B10",
      "layer": 1,
      "name": "Cost guard",
      "parent": "evalops",
      "connectors": [
        "kpis"
      ],
      "children": [],
      "maps": [
        "eval.py::cost_report"
      ],
      "instruction": "Fail the run if a single answer costs more than the budget. Read per-box token counts from the latest trace and compare against COST_BUDGET_USD in config.",
      "parallel": true
    }
  ]
}